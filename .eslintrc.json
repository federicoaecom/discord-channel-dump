{
  "env": {
    "node": true,
    "commonjs": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "globals": {
    "document": "readonly",
    "location": "readonly"
  },
  "rules": {
    "no-constant-condition": ["error", { "checkLoops": false }]
  },
  "ignorePatterns": ["node_modules/", "backups/", "browser-profile/", ".github/", "openspec/"]
}
